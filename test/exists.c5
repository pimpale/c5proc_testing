exists<type Data>
struct Allocator {
	Data *data;
	void *(*allocate)(Data *, unsigned long);
	int id;
};

struct Bump {
	array<char, 64> buf;
	unsigned long used;
};

void *bump_alloc(Bump *, unsigned long);
Bump bump;

Allocator get_bump(void) {
	return {.data = &bump, .allocate = bump_alloc, .id = 1};
}

void *alloc_via(const Allocator *a, unsigned long n) {
	{.data = auto d, .allocate = auto alloc} = *a;
	return alloc(d, n);
}

int f(void) {
	Allocator la = get_bump();
	{auto d, auto alloc, int id} = la;
	typeof(d) d2 = d;
	alloc(d2, 10);
	return id + la.id;
}
