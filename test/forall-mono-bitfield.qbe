export
function l $f(l %.1, l %.3) {
@start.1
	%.2 =l alloc8 8
	storel %.1, %.2
	%.4 =l alloc8 8
	storel %.3, %.4
@body.2
	%.5 =l loadl %.2
	%.6 =w call $"getb<char>"(l %.5)
	%.7 =l loadl %.4
	%.8 =w call $"getb<long>"(l %.7)
	%.9 =w add %.6, %.8
	%.10 =l extuw %.9
	%.11 =l add %.10, 32
	%.12 =l add %.11, 48
	ret %.12
}
function w $"getb<char>"(l %.1) {
@start.3
	%.2 =l alloc8 8
	storel %.1, %.2
@body.4
	%.3 =l loadl %.2
	%.4 =l add %.3, 0
	%.5 =w loadw %.4
	%.6 =w shl %.5, 6
	%.7 =w shr %.6, 25
	%.8 =l loadl %.2
	%.9 =l add %.8, 4
	%.10 =w loadw %.9
	%.11 =w shl %.10, 27
	%.12 =w shr %.11, 27
	%.13 =w add %.7, %.12
	ret %.13
}
function w $"getb<long>"(l %.1) {
@start.5
	%.2 =l alloc8 8
	storel %.1, %.2
@body.6
	%.3 =l loadl %.2
	%.4 =l add %.3, 16
	%.5 =w loadw %.4
	%.6 =w shl %.5, 22
	%.7 =w shr %.6, 25
	%.8 =l loadl %.2
	%.9 =l add %.8, 20
	%.10 =w loadw %.9
	%.11 =w shl %.10, 27
	%.12 =w shr %.11, 27
	%.13 =w add %.7, %.12
	ret %.13
}
