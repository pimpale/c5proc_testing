export data $g = align 8 { d d_2.5, }
data $sg = align 8 { l 7, }
type :s.1 = { w, w, }
export
function $f() {
@start.1
	%.1 =l alloc4 16
	%.2 =l alloc4 4
	%.3 =l alloc8 8
	%.4 =l alloc4 4
	%.5 =l alloc4 4
	%.6 =l alloc4 8
	%.12 =l alloc8 8
	%.13 =l alloc8 8
@body.2
	storew 1, %.2
	storel %.1, %.3
	storew 120, %.4
	storew 42, %.5
	%.7 =:s.1 call extern $mk()
	%.8 =w loadw %.7
	storew %.8, %.6
	%.9 =l add %.7, 4
	%.10 =l add %.6, 4
	%.11 =w loadw %.9
	storew %.11, %.10
	storel extern $mk, %.12
	storel 0, %.13
@for_cond.3
	%.14 =l loadl %.13
	%.15 =l extsw 3
	%.16 =w csltl %.14, %.15
	jnz %.16, @for_body.4, @for_join.6
@for_body.4
@for_cont.5
	%.17 =l loadl %.13
	%.18 =l add %.17, 1
	storel %.18, %.13
	jmp @for_cond.3
@for_join.6
	ret
}
