type :.1 = { l, }
type :big.2 = { l, l, l, }
export
function $f(l %.1, l %.3, :.1 %.5) {
@start.1
	%.2 =l alloc8 8
	storel %.1, %.2
	%.4 =l alloc8 8
	storel %.3, %.4
@body.2
	%.6 =l loadl %.2
	%.7 =l loadl %.2
	%.8 =l extsw 1
	%.9 =l mul %.8, 24
	%.10 =l add %.7, %.9
	call $"swap2<big>"(l %.6, l %.10)
	%.11 =l loadl %.2
	%.12 =l extsw 0
	%.13 =l mul %.12, 24
	%.14 =l add %.11, %.13
	%.15 =l loadl %.2
	%.16 =l extsw 1
	%.17 =l mul %.16, 24
	%.18 =l add %.15, %.17
	%.19 =:big.2 call $"add<big>"(:big.2 %.14, :big.2 %.18, :.1 %.5)
	%.20 =l loadl %.2
	%.21 =l extsw 2
	%.22 =l mul %.21, 24
	%.23 =l add %.20, %.22
	%.24 =l loadl %.19
	storel %.24, %.23
	%.25 =l add %.19, 8
	%.26 =l add %.23, 8
	%.27 =l loadl %.25
	storel %.27, %.26
	%.28 =l add %.25, 8
	%.29 =l add %.26, 8
	%.30 =l loadl %.28
	storel %.30, %.29
	%.31 =l loadl %.4
	%.32 =l extsw 1
	%.33 =l call $"second<short>"(l %.31, l %.32)
	%.34 =l call $"size<big>"()
	ret
}
function $"swap2<big>"(l %.1, l %.3) {
@start.3
	%.2 =l alloc8 8
	storel %.1, %.2
	%.4 =l alloc8 8
	storel %.3, %.4
@body.4
	%.5 =l loadl %.2
	%.6 =l loadl %.4
	call $"swap<big>"(l %.5, l %.6)
	%.7 =l loadl %.2
	%.8 =l loadl %.4
	call $"swap<big>"(l %.7, l %.8)
	ret
}
function :big.2 $"add<big>"(:big.2 %.1, :big.2 %.2, :.1 %.3) {
@start.5
@body.6
	%.4 =l add %.3, 0
	%.5 =l loadl %.4
	%.6 =:big.2 call %.5(:big.2 %.1, :big.2 %.2)
	ret %.6
}
function l $"second<short>"(l %.1, l %.3) {
@start.7
	%.2 =l alloc8 8
	storel %.1, %.2
	%.4 =l alloc8 8
	storel %.3, %.4
@body.8
	%.5 =l loadl %.2
	%.6 =l add %.5, 4
	%.7 =l loadl %.4
	%.8 =l mul %.7, 2
	%.9 =l add %.6, %.8
	ret %.9
}
function l $"size<big>"() {
@start.9
@body.10
	%.1 =l add 24, 56
	%.2 =l add %.1, 8
	ret %.2
}
function $"swap<big>"(l %.1, l %.3) {
@start.11
	%.2 =l alloc8 8
	storel %.1, %.2
	%.4 =l alloc8 8
	storel %.3, %.4
	%.5 =l alloc8 24
@body.12
	%.6 =l loadl %.2
	%.7 =l loadl %.6
	storel %.7, %.5
	%.8 =l add %.6, 8
	%.9 =l add %.5, 8
	%.10 =l loadl %.8
	storel %.10, %.9
	%.11 =l add %.8, 8
	%.12 =l add %.9, 8
	%.13 =l loadl %.11
	storel %.13, %.12
	%.14 =l loadl %.4
	%.15 =l loadl %.2
	%.16 =l loadl %.14
	storel %.16, %.15
	%.17 =l add %.14, 8
	%.18 =l add %.15, 8
	%.19 =l loadl %.17
	storel %.19, %.18
	%.20 =l add %.17, 8
	%.21 =l add %.18, 8
	%.22 =l loadl %.20
	storel %.22, %.21
	%.23 =l loadl %.4
	%.24 =l loadl %.5
	storel %.24, %.23
	%.25 =l add %.5, 8
	%.26 =l add %.23, 8
	%.27 =l loadl %.25
	storel %.27, %.26
	%.28 =l add %.25, 8
	%.29 =l add %.26, 8
	%.30 =l loadl %.28
	storel %.30, %.29
	ret
}
