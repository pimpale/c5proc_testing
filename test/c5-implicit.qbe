export
function w $foo(w %.1, w %.3, w %.5, w %.7) {
@start.1
	%.2 =l alloc4 4
	storew %.1, %.2
	%.4 =l alloc4 4
	storew %.3, %.4
	%.6 =l alloc4 4
	storew %.5, %.6
	%.8 =l alloc4 4
	storew %.7, %.8
@body.2
	%.9 =w loadw %.2
	%.10 =w mul %.9, 1000
	%.11 =w loadw %.4
	%.12 =w mul %.11, 100
	%.13 =w add %.10, %.12
	%.14 =w loadw %.6
	%.15 =w mul %.14, 10
	%.16 =w add %.13, %.15
	%.17 =w loadw %.8
	%.18 =w add %.16, %.17
	ret %.18
}
export
function w $addInt(w %.1, w %.3) {
@start.3
	%.2 =l alloc4 4
	storew %.1, %.2
	%.4 =l alloc4 4
	storew %.3, %.4
@body.4
	%.5 =w loadw %.2
	%.6 =w loadw %.4
	%.7 =w add %.5, %.6
	ret %.7
}
export
function w $addIntTrapping(w %.1, w %.3) {
@start.5
	%.2 =l alloc4 4
	storew %.1, %.2
	%.4 =l alloc4 4
	storew %.3, %.4
@body.6
	%.5 =w loadw %.2
	%.6 =w loadw %.4
	%.7 =w add %.5, %.6
	%.8 =w add %.7, 1000
	ret %.8
}
export
function d $addDouble(d %.1, d %.3) {
@start.7
	%.2 =l alloc8 8
	stored %.1, %.2
	%.4 =l alloc8 8
	stored %.3, %.4
@body.8
	%.5 =d loadd %.2
	%.6 =d loadd %.4
	%.7 =d add %.5, %.6
	ret %.7
}
export data $ADD_DOUBLE = align 8 { l $addDouble, }
data $.Lstring.6 = align 1 { b "%d\012\000", }
type :.1 = { l, }
data $.Lstring.7 = align 1 { b "%g\012\000", }
type :.2 = { l, }
export
function w $main() {
@start.9
	%.3 =l alloc8 8
	%.10 =l alloc8 8
@body.10
	%.1 =w call extern $foo(w 1, w 2, w 3, w 4)
	%.2 =w call extern $printf(l $.Lstring.6, ..., w %.1)
	storel extern $addInt, %.3
	%.4 =w call extern $"add<int>"(w 1, w 2, :.1 %.3)
	%.5 =w call extern $printf(l $.Lstring.6, ..., w %.4)
	%.6 =w call extern $"add<int>"(w 3, w 4, :.1 %.3)
	%.7 =w call extern $printf(l $.Lstring.6, ..., w %.6)
	%.8 =d call extern $"add<double>"(d d_1.5, d d_2, :.2 extern $ADD_DOUBLE)
	%.9 =w call extern $printf(l $.Lstring.7, ..., d %.8)
	storel extern $addIntTrapping, %.10
	%.11 =w call extern $"add<int>"(w 1, w 2, :.1 %.10)
	%.12 =w call extern $printf(l $.Lstring.6, ..., w %.11)
	%.13 =w call extern $"add<int>"(w 1, w 2, :.1 %.3)
	%.14 =w call extern $printf(l $.Lstring.6, ..., w %.13)
	ret 0
}
export comdat
function w $"add<int>"(w %.1, w %.3, :.1 %.5) {
@start.11
	%.2 =l alloc4 4
	storew %.1, %.2
	%.4 =l alloc4 4
	storew %.3, %.4
@body.12
	%.6 =w loadw %.2
	%.7 =w loadw %.4
	%.8 =l add %.5, 0
	%.9 =l loadl %.8
	%.10 =w call %.9(w %.6, w %.7)
	ret %.10
}
export comdat
function d $"add<double>"(d %.1, d %.3, :.2 %.5) {
@start.13
	%.2 =l alloc8 8
	stored %.1, %.2
	%.4 =l alloc8 8
	stored %.3, %.4
@body.14
	%.6 =d loadd %.2
	%.7 =d loadd %.4
	%.8 =l add %.5, 0
	%.9 =l loadl %.8
	%.10 =d call %.9(d %.6, d %.7)
	ret %.10
}
