export
function l $find(l %.1, w %.3) {
@start.7
	%.2 =l alloc8 8
	storel %.1, %.2
	%.4 =l alloc4 4
	storew %.3, %.4
@body.8
@for_cond.9
	%.5 =l loadl %.2
