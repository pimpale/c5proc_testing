	%.9 =w loadsb %.8
	%.10 =w extsb %.9
	%.11 =w loadw %.4
	%.12 =w ceqw %.10, %.11
	jnz %.12, @if_true.13, @if_false.14
@if_true.13
	%.13 =l loadl %.2
