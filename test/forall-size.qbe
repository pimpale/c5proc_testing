export
function l $first(l %.1) {
@start.1
	%.2 =l alloc8 8
	storel %.1, %.2
@body.2
	%.3 =l loadl %.2
	ret %.3
}
export
function l $f(l %.1) {
@start.3
	%.2 =l alloc8 8
	storel %.1, %.2
	%.3 =l alloc4 16
@body.4
	%.4 =w call $"last<int, 4>"(l %.3)
	%.5 =l extsw %.4
	%.6 =l loadl %.2
	%.7 =l call $"grow<long, 3>"(l %.6)
	%.8 =l add %.5, %.7
	%.9 =l call extern $first(l %.3)
	%.10 =w loadw %.9
	%.11 =l extsw %.10
	%.12 =l add %.8, %.11
	%.13 =l add %.12, 16
	ret %.13
}
function w $"last<int, 4>"(l %.1) {
@start.5
	%.2 =l alloc8 8
	storel %.1, %.2
@body.6
	%.3 =l loadl %.2
	%.4 =l extsw 1
	%.5 =l sub 4, %.4
	%.6 =l mul %.5, 4
	%.7 =l add %.3, %.6
	%.8 =w loadw %.7
	ret %.8
}
function l $"grow<long, 3>"(l %.1) {
@start.7
	%.2 =l alloc8 8
	storel %.1, %.2
	%.3 =l alloc8 40
@body.8
	%.4 =l add 40, 3
	ret %.4
}
