type :big.1 = { l, l, l, }
export
function l $g(:big.1 %.1) {
@start.1
@body.2
	%.2 =l call $"f<int>"(w 1)
	%.3 =l call $"f<big>"(:big.1 %.1)
	%.4 =l add %.2, %.3
	ret %.4
}
function l $"f<int>"(w %.1) {
@start.3
	%.2 =l alloc4 4
	storew %.1, %.2
	%.3 =l alloc4 4
	%.4 =l alloc4 12
@body.4
	%.5 =l add 4, 12
	ret %.5
}
function l $"f<big>"(:big.1 %.1) {
@start.5
	%.2 =l alloc4 24
	%.3 =l alloc8 48
@body.6
	%.4 =l add 24, 48
	ret %.4
}
