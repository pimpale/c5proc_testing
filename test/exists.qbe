type :Allocator.1 = { l, l, w, }
export
function :Allocator.1 $get_bump() {
@start.1
	%.1 =l alloc8 24
@body.2
	storel extern $bump, %.1
	%.2 =l add %.1, 8
	storel extern $bump_alloc, %.2
	%.3 =l add %.1, 16
	storew 1, %.3
	%.4 =l add %.1, 20
	storew 0, %.4
	ret %.1
}
export
function l $alloc_via(l %.1, l %.3) {
@start.3
	%.2 =l alloc8 8
	storel %.1, %.2
	%.4 =l alloc8 8
	storel %.3, %.4
	%.5 =l alloc8 24
@body.4
	%.6 =l loadl %.2
	%.7 =l loadl %.6
	storel %.7, %.5
	%.8 =l add %.6, 8
	%.9 =l add %.5, 8
	%.10 =l loadl %.8
	storel %.10, %.9
	%.11 =l add %.8, 8
	%.12 =l add %.9, 8
	%.13 =l loadl %.11
	storel %.13, %.12
	%.14 =l add %.5, 0
	%.15 =l loadl %.14
	%.16 =l loadl %.4
	%.17 =l add %.5, 8
	%.18 =l loadl %.17
	%.19 =l call %.18(l %.15, l %.16)
	ret %.19
}
export
function w $f() {
@start.5
	%.1 =l alloc8 24
	%.10 =l alloc8 24
	%.18 =l alloc8 8
@body.6
	%.2 =:Allocator.1 call extern $get_bump()
	%.3 =l loadl %.2
	storel %.3, %.1
	%.4 =l add %.2, 8
	%.5 =l add %.1, 8
	%.6 =l loadl %.4
	storel %.6, %.5
	%.7 =l add %.4, 8
	%.8 =l add %.5, 8
	%.9 =l loadl %.7
	storel %.9, %.8
	%.11 =l loadl %.1
	storel %.11, %.10
	%.12 =l add %.1, 8
	%.13 =l add %.10, 8
	%.14 =l loadl %.12
	storel %.14, %.13
	%.15 =l add %.12, 8
	%.16 =l add %.13, 8
	%.17 =l loadl %.15
	storel %.17, %.16
	%.19 =l add %.10, 0
	%.20 =l loadl %.19
	storel %.20, %.18
	%.21 =l loadl %.18
	%.22 =l extsw 10
	%.23 =l add %.10, 8
	%.24 =l loadl %.23
	%.25 =l call %.24(l %.21, l %.22)
	%.26 =l add %.10, 16
	%.27 =w loadw %.26
	%.28 =l add %.1, 16
	%.29 =w loadw %.28
	%.30 =w add %.27, %.29
	ret %.30
}
export data $bump = align 8 { z 72 }
